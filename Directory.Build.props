<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Invariant globalization mode is NOT enabled: Microsoft.Data.SqlClient
         does not support it and throws at the first connection. Culture
         sensitivity is handled where it belongs instead — every parse and
         format in the engine passes CultureInfo.InvariantCulture explicitly,
         so a server with a Turkish or Arabic locale reads the same numbers and
         dates as one with an English locale. -->
  </PropertyGroup>
</Project>
