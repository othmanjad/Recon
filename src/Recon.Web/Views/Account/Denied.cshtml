@{
    var level = Context.Request.Query["level"].ToString();
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="rc-card">
            <div class="rc-card-head">
                <h2>Access denied</h2>
            </div>
            <div class="p-4">
                <p class="mb-3">
                    <i class="bi bi-shield-lock text-danger fs-4 align-middle" aria-hidden="true"></i>
                    <span class="align-middle ms-2">
                        @if (string.IsNullOrEmpty(level))
                        {
                            <text>You do not have access to that.</text>
                        }
                        else
                        {
                            <text>That action needs <strong>@level</strong> access to the counterparty it belongs to.</text>
                        }
                    </span>
                </p>

                @*
                    Deliberately not naming the counterparty: a missing grant
                    and an insufficient one get the same answer, because which
                    counterparties exist is itself a disclosure.
                *@
                <p class="rc-help mb-3">
                    Permissions are scoped per counterparty (design §13): a user managing one
                    partner need not see another's data. A missing grant and an insufficient one
                    give the same answer here on purpose — telling you which counterparties exist
                    would itself disclose something.
                </p>

                <p class="rc-help mb-4">
                    The refusal is in the log. Ask whoever holds <strong>Configure</strong> on that
                    counterparty to grant you access on the Counterparties screen.
                </p>

                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">
                    Back to the dashboard
                </a>
            </div>
        </div>
    </div>
</div>
