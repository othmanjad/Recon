@using Recon.Domain.Configuration
@using Recon.Web.Controllers
@{
    var datasets = (List<DatasetRow>)ViewData["Datasets"]!;
    var selected = ViewData["Selected"] as Dataset;
    var selectedRow = ViewData["SelectedRow"] as DatasetRow;
    var slots = (List<SlotOption>)ViewData["Slots"]!;
    var problems = (IReadOnlyList<string>)ViewData["Problems"]!;
    var counterparties = (List<CounterpartyRow>)ViewData["Counterparties"]!;
    var currencies = (List<Currency>)ViewData["Currencies"]!;
    var formats = (List<FormatRow>)ViewData["Formats"]!;
    var format = ViewData["Format"] as FormatRow;
    var mappings = (List<MappingRow>)ViewData["Mappings"]!;
    var canConfigure = ViewData["CanConfigure"] is true;
    var today = DateOnly.FromDateTime(DateTime.Today);

    var usedSlots = selected?.Fields.Select(f => f.StorageSlot).ToHashSet(StringComparer.Ordinal)
        ?? new HashSet<string>(StringComparer.Ordinal);

    var usedCompanions = selected?.Fields
        .Where(f => f.NormalizedSlot is not null)
        .Select(f => f.NormalizedSlot!)
        .ToHashSet(StringComparer.Ordinal) ?? new HashSet<string>(StringComparer.Ordinal);
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">Datasets &amp; fields</h1>
    <form method="get" asp-action="Index" class="d-flex gap-2 rc-picker">
        <select class="form-select form-select-sm" name="id" style="width:auto" aria-label="Dataset">
            @foreach (var dataset in datasets)
            {
                <option value="@dataset.DatasetId" selected="@(selected?.DatasetId == dataset.DatasetId)">
                    @dataset.CounterpartyCode / @dataset.Code
                </option>
            }
        </select>
        <button class="btn btn-sm btn-primary" type="submit">Open</button>
    </form>
</div>

@*
    The registry is the only path to the data. Nothing outside the provider
    and compiler layers references a storage slot, which is what preserves
    the option to change the storage model later (§7).
*@
<div class="alert alert-light border d-flex gap-2 align-items-start">
    <i class="bi bi-shield-check fs-5 text-primary" aria-hidden="true"></i>
    <div class="small">
        <strong>This table is the field registry.</strong> Every rule, classification, exclusion,
        report column and control total resolves field names against it and never from free text —
        that is what keeps a user-driven rule builder away from SQL. A field not marked
        <em>matchable</em> can be displayed and exported but can never appear in a condition.
    </div>
</div>

@if (datasets.Count == 0)
{
    <div class="rc-card"><div class="rc-empty">No datasets are visible to you.</div></div>
}
else if (selected is null)
{
    <div class="rc-card"><div class="rc-empty">Choose a dataset.</div></div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="rc-card h-100">
                <div class="rc-card-head">
                    <h2>@selected.Code — @selected.Name</h2>
                    <div class="d-flex gap-2 align-items-center">
                        @if (selected.IsActive)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                        <form asp-action="Activate" method="post" class="m-0">
                            <input type="hidden" name="id" value="@selected.DatasetId">
                            <input type="hidden" name="active" value="@(selected.IsActive ? "false" : "true")">
                            <button class="btn btn-sm @(selected.IsActive ? "btn-outline-secondary" : "btn-outline-primary")"
                                    type="submit">
                                @(selected.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    </div>
                </div>
                <div class="p-3">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-3">Provider</dt>
                        <dd class="col-sm-3">@selected.Provider</dd>
                        <dt class="col-sm-3">Time zone</dt>
                        <dd class="col-sm-3">@selected.TimeZone</dd>

                        <dt class="col-sm-3">Default currency</dt>
                        <dd class="col-sm-3">@(selected.DefaultCurrency ?? "—")</dd>
                        <dt class="col-sm-3">Fields</dt>
                        <dd class="col-sm-3">
                            @selected.Fields.Count
                            (@selected.Fields.Count(f => f.IsMatchable) matchable,
                            @selected.Fields.Count(f => f.IsIndexed) indexed)
                        </dd>

                        <dt class="col-sm-3">Duplicate key</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrWhiteSpace(selected.DuplicateKeyFields))
                            {
                                <span class="text-danger">not declared</span>
                                <span class="rc-help">
                                    — a file containing the same reference twice would match one row
                                    and orphan the other, with no signal that the source was the
                                    problem (finding C3).
                                </span>
                            }
                            else
                            {
                                <code class="rc-field">@selected.DuplicateKeyFields</code>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="rc-card h-100">
                <div class="rc-card-head"><h2>Activation</h2></div>
                <div class="p-3">
                    @if (problems.Count == 0)
                    {
                        <div class="d-flex gap-2 align-items-start">
                            <i class="bi bi-check-circle text-success fs-5" aria-hidden="true"></i>
                            <div class="small">
                                Every universal role is mapped and the slot pools are respected.
                                This dataset can be activated.
                            </div>
                        </div>
                    }
                    else
                    {
                        @* The gate of review item B6: the rule existed in prose
                           and had no enforcement point. *@
                        <ul class="mb-0 small text-danger">
                            @foreach (var problem in problems)
                            {
                                <li class="mb-1">@problem</li>
                            }
                        </ul>
                    }

                    <hr>
                    <div class="rc-tile-label mb-2">Universal roles</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var role in ReconciliationDefinition.RequiredRoles)
                        {
                            var field = selected.FieldWithRole(role);
                            <span class="badge @(field is null ? "text-bg-danger" : "text-bg-success")"
                                  title="@(field is null ? "not mapped" : field.FieldCode)">
                                @role
                            </span>
                        }
                    </div>
                    <div class="rc-help mt-2">
                        The engine never looks for a field <em>named</em> "Amount"; it looks for the
                        field whose role <em>is</em> Amount. That is what makes control totals, fee
                        calculation and date partitioning work across partners that name nothing
                        alike.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="rc-card mb-3">
        <div class="rc-card-head">
            <h2>Field registry</h2>
            <span class="rc-help">@selected.Fields.Count field(s)</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="text-end">#</th>
                        <th>Code</th><th>Label</th><th>Type</th><th>Role</th><th>Slot</th>
                        <th>Matchable</th><th>Indexed</th><th>Required</th>
                        <th>Normalized companion</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (selected.Fields.Count == 0)
                    {
                        <tr><td colspan="11" class="rc-empty">This dataset has no fields yet.</td></tr>
                    }
                    @foreach (var field in selected.Fields.OrderBy(f => f.DisplayOrder))
                    {
                        <tr>
                            <td class="rc-num">@field.DisplayOrder</td>
                            <td><code class="rc-field">@field.FieldCode</code></td>
                            <td>@field.DisplayLabel</td>
                            <td class="rc-help">@field.DataType</td>
                            <td>@Fmt.RoleBadge(field.Role?.ToString())</td>
                            <td class="rc-mono">@field.StorageSlot</td>
                            <td>
                                @if (field.IsMatchable)
                                {
                                    <i class="bi bi-check-lg text-success" aria-label="matchable"></i>
                                }
                                else
                                {
                                    <i class="bi bi-dash text-muted" aria-label="not matchable"></i>
                                }
                            </td>
                            <td>
                                @if (field.IsIndexed)
                                {
                                    <i class="bi bi-check-lg text-success" aria-label="indexed"></i>
                                }
                                else
                                {
                                    <i class="bi bi-dash text-muted" aria-label="not indexed"></i>
                                }
                            </td>
                            <td>
                                @if (field.IsRequired)
                                {
                                    <i class="bi bi-check-lg text-success" aria-label="required"></i>
                                }
                                else
                                {
                                    <i class="bi bi-dash text-muted" aria-label="optional"></i>
                                }
                            </td>
                            <td class="rc-mono">
                                @if (field.NormalizeForMatch)
                                {
                                    <text>@field.NormalizedSlot</text>
                                }
                                else
                                {
                                    <span class="rc-help">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary rc-field-edit" type="button"
                                        data-id="@field.DatasetFieldId"
                                        data-code="@field.FieldCode"
                                        data-label="@field.DisplayLabel"
                                        data-type="@field.DataType"
                                        data-role="@(field.Role?.ToString())"
                                        data-slot="@field.StorageSlot"
                                        data-matchable="@field.IsMatchable.ToString().ToLowerInvariant()"
                                        data-indexed="@field.IsIndexed.ToString().ToLowerInvariant()"
                                        data-required="@field.IsRequired.ToString().ToLowerInvariant()"
                                        data-normalize="@field.NormalizeForMatch.ToString().ToLowerInvariant()"
                                        data-normslot="@field.NormalizedSlot"
                                        data-order="@field.DisplayOrder">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="rc-card" id="rc-field-editor">
        <div class="rc-card-head">
            <h2><span id="rc-field-editor-title">Add a field</span></h2>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="rc-field-reset">
                New field
            </button>
        </div>
        <div class="p-3">
            <form asp-action="SaveField" method="post" class="row g-3" id="rc-field-form">
                <input type="hidden" name="datasetId" value="@selected.DatasetId">
                <input type="hidden" name="datasetFieldId" id="datasetFieldId">

                <div class="col-md-3">
                    <label class="form-label" for="fieldCode">Field code</label>
                    <input class="form-control" id="fieldCode" name="fieldCode" required
                           placeholder="REF_PRIMARY">
                    <div class="form-text">
                        Rules cite this, case-sensitively. Changing it breaks every rule that names it.
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="displayLabel">Label</label>
                    <input class="form-control" id="displayLabel" name="displayLabel" required
                           placeholder="End To End Id">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="dataType">Type</label>
                    <select class="form-select" id="dataType" name="dataType" required>
                        @foreach (var type in Enum.GetNames<FieldDataType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="fieldRole">Role</label>
                    <select class="form-select" id="fieldRole" name="fieldRole">
                        <option value="">(none)</option>
                        @foreach (var role in Enum.GetNames<FieldRole>())
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="displayOrder">Order</label>
                    <input class="form-control" type="number" id="displayOrder" name="displayOrder"
                           value="@(selected.Fields.Count + 1)" required>
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="storageSlot">Storage slot</label>
                    <select class="form-select" id="storageSlot" name="storageSlot" required>
                        @foreach (var slot in slots.Where(s => !s.NormalizedOnly))
                        {
                            <option value="@slot.Name" data-type="@slot.Type"
                                    data-used="@(usedSlots.Contains(slot.Name).ToString().ToLowerInvariant())">
                                @slot.Name@(slot.MaxLength is { } length ? $" ({length})" : "")@(usedSlots.Contains(slot.Name) ? " — in use" : "")
                            </option>
                        }
                    </select>
                    <div class="form-text">
                        The slot's type must equal the field's type, and it must come from the
                        reservable pool — the database enforces both.
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="normalizedSlot">Normalized companion</label>
                    <select class="form-select" id="normalizedSlot" name="normalizedSlot">
                        <option value="">(none)</option>
                        @foreach (var slot in slots.Where(s => s.NormalizedOnly))
                        {
                            <option value="@slot.Name"
                                    data-used="@(usedCompanions.Contains(slot.Name).ToString().ToLowerInvariant())">
                                @slot.Name@(usedCompanions.Contains(slot.Name) ? " — in use" : "")
                            </option>
                        }
                    </select>
                    <div class="form-text">
                        Text21..Text30 only. The pools are separate because a companion could
                        otherwise silently overwrite a mapped field.
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isMatchable" name="isMatchable"
                               value="true" checked>
                        <input type="hidden" name="isMatchable" value="false">
                        <label class="form-check-label" for="isMatchable">
                            <strong>Matchable</strong> — may appear in a rule condition
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isIndexed" name="isIndexed"
                               value="true">
                        <input type="hidden" name="isIndexed" value="false">
                        <label class="form-check-label" for="isIndexed">
                            <strong>Indexed</strong> — maintain an index on it (at most four per
                            dataset; every extra index is a 2M-row cost on every load)
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isRequired" name="isRequired"
                               value="true">
                        <input type="hidden" name="isRequired" value="false">
                        <label class="form-check-label" for="isRequired">
                            <strong>Required</strong> — a row without it is a parse error
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="normalizeForMatch"
                               name="normalizeForMatch" value="true">
                        <input type="hidden" name="normalizeForMatch" value="false">
                        <label class="form-check-label" for="normalizeForMatch">
                            <strong>Normalize at load</strong> — write an upper-cased, trimmed copy
                            into the companion slot so a rule can compare it with an indexed
                            <code>Exact</code> match instead of forcing a scan
                        </label>
                    </div>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save field</button>
                    <span class="rc-help align-self-center" id="rc-field-hint"></span>
                </div>
            </form>
        </div>
    </div>
}

@if (counterparties.Count > 0)
{
    @*
        A dataset can now be created here rather than in SQL. Without this the
        Phase 3 exit criterion — Operations onboards a second counterparty
        unassisted — could not be met from the portal at all: a counterparty
        with no dataset has nothing to reconcile.
    *@
    <div class="rc-card mt-3">
        <div class="rc-card-head">
            <h2>@(selectedRow is null ? "Add a dataset" : "Edit " + selectedRow.Code)</h2>
            @if (selectedRow is not null)
            {
                @* blank=true, not just "no id": without it the screen falls
                   back to the first dataset and the form is an edit of that. *@
                <a class="btn btn-sm btn-outline-secondary"
                   asp-action="Index" asp-route-blank="true">New dataset</a>
            }
        </div>
        <div class="p-3">
            <form asp-action="SaveDataset" method="post" class="row g-3">
                @if (selected is not null && canConfigure)
                {
                    <input type="hidden" name="datasetId" value="@selected.DatasetId">
                }
                <div class="col-md-3">
                    <label class="form-label" for="counterpartyId">Counterparty</label>
                    <select class="form-select" id="counterpartyId" name="counterpartyId" required>
                        @foreach (var counterparty in counterparties)
                        {
                            <option value="@counterparty.CounterpartyId"
                                    selected="@(selectedRow?.CounterpartyId == counterparty.CounterpartyId)">
                                @counterparty.Code
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="dsCode">Code</label>
                    <input class="form-control" id="dsCode" name="code" required
                           value="@selectedRow?.Code" placeholder="CLIQ_SESSION">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="dsName">Name</label>
                    <input class="form-control" id="dsName" name="name" required
                           value="@selectedRow?.Name">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="providerType">Provider</label>
                    <select class="form-select" id="providerType" name="providerType">
                        @foreach (var provider in Enum.GetNames<ProviderType>())
                        {
                            <option value="@provider"
                                    selected="@(selectedRow?.ProviderType == provider)">
                                @provider
                            </option>
                        }
                    </select>
                    <div class="form-text">
                        File, a SQL view or procedure, or an API. The engine treats all three as a
                        dataset.
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label" for="timeZone">Time zone</label>
                    <input class="form-control" id="timeZone" name="timeZone"
                           value="@(selectedRow?.TimeZone ?? "Asia/Amman")">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="defaultCurrency">Default currency</label>
                    <select class="form-select" id="defaultCurrency" name="defaultCurrency">
                        <option value="">(none)</option>
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency.Code"
                                    selected="@(selectedRow?.DefaultCurrency == currency.Code)">
                                @currency.Code — @currency.MinorUnits minor units
                            </option>
                        }
                    </select>
                    <div class="form-text">
                        The scale every amount in this dataset is parsed into. Wrong here is a
                        factor-of-ten error in every row.
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="duplicateKeyFields">Duplicate key</label>
                    <input class="form-control rc-mono" id="duplicateKeyFields"
                           name="duplicateKeyFields" value="@selectedRow?.DuplicateKeyFields"
                           placeholder="REF_PRIMARY, TX_DATETIME">
                    <div class="form-text">
                        Field codes, comma-separated, and each must be in the registry above. The
                        second occurrence of a key in one file is flagged <code>Duplicate</code>
                        before matching — without a key declared, a file containing the same
                        reference twice matches one row and orphans the other with no signal that
                        the source was the problem.
                    </div>
                </div>

                <div class="col-12">
                    <button class="btn btn-primary" type="submit">Save dataset</button>
                    @if (selected is null)
                    {
                        <span class="rc-help ms-2">
                            Created inactive and with no fields — the registry, a file format and
                            its mappings come next, and activation checks them.
                        </span>
                    }
                </div>
            </form>
        </div>
    </div>
}

@if (selected is not null)
{
    <div class="rc-card mt-3">
        <div class="rc-card-head">
            <h2>File formats</h2>
            <span class="rc-help">effective-dated, so a 2024 file still reads correctly in 2026</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Version</th><th>Type</th><th>Effective</th><th>Layout</th>
                        <th class="text-end">Mappings</th><th class="text-end">Max errors</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (formats.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="rc-empty">
                                No format. This dataset cannot be loaded at all — a file cannot be
                                parsed without one, and guessing a layout would stage wrong data.
                            </td>
                        </tr>
                    }
                    @foreach (var row in formats)
                    {
                        <tr class="@(format?.FileFormatId == row.FileFormatId ? "table-active" : null)">
                            <td class="rc-num">
                                @row.Version
                                @if (row.CoversToday)
                                {
                                    <span class="badge text-bg-primary">in force today</span>
                                }
                            </td>
                            <td>@row.FormatType</td>
                            <td class="rc-mono">
                                @row.EffectiveFrom.ToString("yyyy-MM-dd") →
                                @(row.EffectiveTo?.ToString("yyyy-MM-dd") ?? "open")
                            </td>
                            <td class="rc-mono rc-help">
                                @if (row.FormatType == "Csv")
                                {
                                    <text>delimiter “@row.Delimiter”</text>
                                    @if (!string.IsNullOrEmpty(row.TextQualifier))
                                    {
                                        <text>, qualifier “@row.TextQualifier”</text>
                                    }
                                    <text>, @(row.HasHeader ? "header" : "no header")</text>
                                }
                                else
                                {
                                    <text>@row.RecordPath</text>
                                }
                            </td>
                            <td class="rc-num @(row.MappingCount == 0 ? "rc-num-neg" : null)">
                                @row.MappingCount
                            </td>
                            <td class="rc-num">@row.MaxParseErrors</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Index" asp-route-id="@selected.DatasetId"
                                   asp-route-formatId="@row.FileFormatId">Mappings</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (canConfigure)
        {
            <div class="p-3 border-top">
                <form asp-action="SaveFormat" method="post" class="row g-3" id="rc-format-form">
                    <input type="hidden" name="datasetId" value="@selected.DatasetId">
                    <div class="col-md-3">
                        <label class="form-label" for="editFormat">Editing</label>
                        <select class="form-select" id="editFormat" name="fileFormatId" data-rc-formats>
                            <option value="">(new version)</option>
                            @foreach (var row in formats)
                            {
                                <option value="@row.FileFormatId"
                                        selected="@(format?.FileFormatId == row.FileFormatId)"
                                        data-type="@row.FormatType"
                                        data-version="@row.Version"
                                        data-from="@row.EffectiveFrom.ToString("yyyy-MM-dd")"
                                        data-to="@(row.EffectiveTo?.ToString("yyyy-MM-dd"))"
                                        data-delimiter="@row.Delimiter"
                                        data-qualifier="@row.TextQualifier"
                                        data-encoding="@row.Encoding"
                                        data-header="@row.HasHeader.ToString().ToLowerInvariant()"
                                        data-skiplead="@row.SkipLeadingLines"
                                        data-skiptrail="@row.SkipTrailingLines"
                                        data-recordpath="@row.RecordPath"
                                        data-pattern="@row.FileNamePattern"
                                        data-maxerrors="@row.MaxParseErrors">
                                    v@row.Version (@row.FormatType, @row.EffectiveFrom.ToString("yyyy-MM-dd"))
                                </option>
                            }
                        </select>
                        <div class="form-text">
                            A layout change is a <strong>new version</strong> with a later effective
                            date. Editing the one in force changes how every historical re-run
                            parses.
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="formatType">Type</label>
                        <select class="form-select" id="formatType" name="formatType">
                            @foreach (var type in Enum.GetNames<FileFormatType>())
                            {
                                <option value="@type" selected="@(format?.FormatType == type)">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label" for="version">Version</label>
                        <input class="form-control" type="number" id="version" name="version" min="1"
                               value="@(formats.Count == 0 ? 1 : formats.Max(f => f.Version) + 1)" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="effectiveFrom">Effective from</label>
                        <input class="form-control" type="date" id="effectiveFrom" name="effectiveFrom"
                               value="@today.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="effectiveTo">Effective to</label>
                        <input class="form-control" type="date" id="effectiveTo" name="effectiveTo">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="maxParseErrors">Max parse errors</label>
                        <input class="form-control" type="number" id="maxParseErrors" name="maxParseErrors"
                               min="0" value="1000" required>
                        <div class="form-text">
                            Beyond this the file is treated as the wrong format and the load stops —
                            otherwise a mis-sent file writes one error row per source row.
                        </div>
                    </div>

                    <div class="col-md-2 rc-csv-only">
                        <label class="form-label" for="delimiter">Delimiter</label>
                        <input class="form-control rc-mono" id="delimiter" name="delimiter" value=",">
                    </div>
                    <div class="col-md-2 rc-csv-only">
                        <label class="form-label" for="textQualifier">Text qualifier</label>
                        <input class="form-control rc-mono" id="textQualifier" name="textQualifier"
                               value="&quot;">
                    </div>
                    <div class="col-md-2 rc-csv-only">
                        <label class="form-label" for="skipLeadingLines">Skip leading</label>
                        <input class="form-control" type="number" id="skipLeadingLines"
                               name="skipLeadingLines" min="0" value="0">
                    </div>
                    <div class="col-md-2 rc-csv-only">
                        <label class="form-label" for="skipTrailingLines">Skip trailing</label>
                        <input class="form-control" type="number" id="skipTrailingLines"
                               name="skipTrailingLines" min="0" value="0">
                        <div class="form-text">A trailer line with a control total, for instance.</div>
                    </div>
                    <div class="col-md-2 rc-csv-only d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hasHeader"
                                   name="hasHeader" value="true" checked>
                            <input type="hidden" name="hasHeader" value="false">
                            <label class="form-check-label" for="hasHeader">Has a header row</label>
                        </div>
                    </div>

                    <div class="col-md-4 rc-path-only">
                        <label class="form-label" for="recordPath">Record path</label>
                        <input class="form-control rc-mono" id="recordPath" name="recordPath"
                               placeholder="//Document/Transaction or $.transactions[*]">
                        <div class="form-text">
                            XPath for XML, JsonPath for JSON. Without it the reader does not know
                            where one record ends and the next begins.
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="encoding">Encoding</label>
                        <input class="form-control" id="encoding" name="encoding" value="UTF-8">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="fileNamePattern">File name pattern</label>
                        <input class="form-control rc-mono" id="fileNamePattern" name="fileNamePattern"
                               placeholder="^CLIQ_SESSION_\d{8}_S\d+\.csv$">
                        <div class="form-text">A regex, checked on acquisition. Optional.</div>
                    </div>

                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Save format</button>
                    </div>
                </form>
            </div>
        }
    </div>

    @if (format is not null)
    {
        <div class="rc-card mt-3">
            <div class="rc-card-head">
                <h2>Field mappings — v@format.Version (@format.FormatType)</h2>
                <span class="rc-help">
                    @mappings.Count of @selected.Fields.Count registry field(s) mapped
                </span>
            </div>
            <div class="rc-table-scroll">
                <table class="table rc-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Field</th><th>Source</th><th>Parse format</th>
                            <th>Transforms</th><th>Default</th><th>Required</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (mappings.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="rc-empty">
                                    Nothing is mapped, so this format stages nothing.
                                </td>
                            </tr>
                        }
                        @foreach (var mapping in mappings)
                        {
                            <tr>
                                <td>
                                    <code class="rc-field">@mapping.FieldCode</code>
                                    <div class="rc-help">
                                        @mapping.DisplayLabel · @mapping.DataType · @mapping.StorageSlot
                                    </div>
                                </td>
                                <td class="rc-mono">@mapping.SourcePath</td>
                                <td class="rc-mono">@(mapping.ParseFormat ?? "—")</td>
                                <td class="rc-mono rc-help" style="max-width:280px">
                                    @(mapping.TransformChainJson ?? "—")
                                </td>
                                <td class="rc-mono">@(mapping.DefaultValue ?? "—")</td>
                                <td>
                                    @if (mapping.IsRequired)
                                    {
                                        <i class="bi bi-check-lg text-success" aria-label="required"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-dash text-muted" aria-label="optional"></i>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (canConfigure)
                                    {
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button class="btn btn-sm btn-outline-secondary rc-mapping-edit"
                                                    type="button"
                                                    data-id="@mapping.FieldMappingId"
                                                    data-field="@mapping.FieldCode"
                                                    data-path="@mapping.SourcePath"
                                                    data-format="@mapping.ParseFormat"
                                                    data-transforms="@mapping.TransformChainJson"
                                                    data-default="@mapping.DefaultValue"
                                                    data-required="@mapping.IsRequired.ToString().ToLowerInvariant()">
                                                Edit
                                            </button>
                                            <form asp-action="DeleteMapping" method="post" class="m-0">
                                                <input type="hidden" name="datasetId" value="@selected.DatasetId">
                                                <input type="hidden" name="fileFormatId" value="@format.FileFormatId">
                                                <input type="hidden" name="fieldMappingId" value="@mapping.FieldMappingId">
                                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                                        data-rc-confirm="Remove the mapping for @mapping.FieldCode?">
                                                    Remove
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (canConfigure)
            {
                <div class="p-3 border-top">
                    <form asp-action="SaveMapping" method="post" class="row g-3" id="rc-mapping-form">
                        <input type="hidden" name="datasetId" value="@selected.DatasetId">
                        <input type="hidden" name="fileFormatId" value="@format.FileFormatId">
                        <input type="hidden" name="fieldMappingId" id="fieldMappingId">

                        <div class="col-md-3">
                            <label class="form-label" for="mapFieldCode">Registry field</label>
                            <select class="form-select" id="mapFieldCode" name="fieldCode" required>
                                @foreach (var field in selected.Fields.OrderBy(f => f.DisplayOrder))
                                {
                                    <option value="@field.FieldCode"
                                            data-type="@field.DataType"
                                            data-mapped="@(mappings.Any(m => m.FieldCode == field.FieldCode)
                                                ? "true" : "false")">
                                        @field.DisplayLabel (@field.FieldCode)@(mappings.Any(m => m.FieldCode == field.FieldCode) ? " — mapped" : "")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="sourcePath">Source</label>
                            <input class="form-control rc-mono" id="sourcePath" name="sourcePath" required
                                   placeholder="a column name, or an XPath, or a JsonPath">
                            <div class="form-text" id="rc-source-hint"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="parseFormat">Parse format</label>
                            <input class="form-control rc-mono" id="parseFormat" name="parseFormat"
                                   placeholder="yyyyMMddHHmmss">
                            <div class="form-text" id="rc-parse-hint"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="defaultValue">Default</label>
                            <input class="form-control" id="defaultValue" name="defaultValue"
                                   placeholder="when absent">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mapRequired"
                                       name="isRequired" value="true">
                                <input type="hidden" name="isRequired" value="false">
                                <label class="form-check-label" for="mapRequired">Required</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="transformChainJson">Transform chain</label>
                            <input class="form-control rc-mono" id="transformChainJson"
                                   name="transformChainJson"
                                   placeholder='[{"op":"Trim"},{"op":"Upper"}]'>
                            @*
                                Validated by the engine's own parser on save, so
                                the portal accepts exactly what the loader will.
                            *@
                            @*
                                The list comes from the engine, not from beside
                                it: a help text naming an operation the parser
                                does not know sends an operator to a failed run.
                            *@
                            <div class="form-text">
                                A JSON array of steps, validated by the loader's own parser on save:
                                @Html.Raw(string.Join(", ",
                                    Recon.Engine.Parsing.Transforms.Operations
                                        .Select(o => $"<code>{o}</code>"))).
                                <code>Substring</code> takes <code>start</code> and
                                <code>length</code>, <code>RegexExtract</code> a
                                <code>pattern</code>, <code>Replace</code> a <code>from</code> and
                                <code>to</code>. A regex here runs against two million values per
                                file, so it is bounded by a timeout.
                            </div>
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Save mapping</button>
                            <button class="btn btn-outline-secondary" type="button" id="rc-mapping-reset">
                                New mapping
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
}

@section Scripts {
    <script src="~/js/datasets.js"></script>
}
