@using Recon.Web.Controllers
@{
    var counterparties = (List<CounterpartyRow>)ViewData["Counterparties"]!;
    var selected = ViewData["Selected"] as CounterpartyRow;
    var currencies = (List<Currency>)ViewData["Currencies"]!;
    var schedules = (List<FeeScheduleRow>)ViewData["Schedules"]!;
    var datasets = (List<DatasetRow>)ViewData["Datasets"]!;
    var applicability = (List<ApplicabilityRow>)ViewData["Applicability"]!;
    var summaries = (List<InterchangeRow>)ViewData["Summaries"]!;
    var canConfigure = ViewData["CanConfigure"] is true;
    var editing = ViewData["EditingScheduleId"] as int?;
    var today = DateOnly.FromDateTime(DateTime.Today);

    int Scale(string currencyCode) =>
        currencies.FirstOrDefault(c => c.Code == currencyCode)?.MinorUnits ?? Fmt.Scale(currencyCode);
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">Fees &amp; interchange</h1>
    <form method="get" asp-action="Index" class="d-flex gap-2 rc-picker">
        <select class="form-select form-select-sm" name="id" style="width:auto" aria-label="Counterparty">
            @foreach (var row in counterparties)
            {
                <option value="@row.CounterpartyId" selected="@(selected?.CounterpartyId == row.CounterpartyId)">
                    @row.Code
                </option>
            }
        </select>
        <button class="btn btn-sm btn-primary" type="submit">Open</button>
    </form>
</div>

@*
    Two properties that are easy to get silently wrong, said out loud:
    minor units, and effective dating.
*@
<div class="alert alert-light border small">
    <strong>Every amount here is in minor units.</strong> 1.000 JOD is <code>1000</code> (JOD has
    three); 1.00 USD is <code>100</code>. A schedule entered in major units under-charges by three
    orders of magnitude and nothing fails. <strong>A rate change is a new schedule</strong> with a
    later effective date, never an edit — a tariff change must not retroactively alter last month's
    figures.
</div>

@if (selected is null)
{
    <div class="rc-card"><div class="rc-empty">No counterparty is visible to you.</div></div>
}
else
{
    <div class="rc-card mb-3">
        <div class="rc-card-head">
            <h2>Fee schedules for @selected.Code</h2>
            <span class="rc-help">@schedules.Count schedule(s)</span>
        </div>
        <div class="p-3">
            @if (schedules.Count == 0)
            {
                <div class="rc-help">
                    No schedule. Fee calculation for this counterparty charges nothing and reports
                    that it found no schedule covering the business date — which is a different
                    statement from charging zero.
                </div>
            }
            @foreach (var schedule in schedules)
            {
                <div class="rc-pass mb-3">
                    <div class="rc-pass-head">
                        <span class="rc-mono">@schedule.Code</span>
                        <span>@schedule.Name</span>
                        <span class="badge text-bg-@(schedule.FeeParty == "Revenue" ? "success" : "dark")">
                            @schedule.FeeParty
                        </span>
                        <span class="badge text-bg-light border">@schedule.Direction</span>
                        @if (schedule.TransactionType is { Length: > 0 } txnType)
                        {
                            <span class="badge text-bg-light border">@txnType</span>
                        }
                        <span class="badge text-bg-light border">@schedule.CurrencyCode</span>
                        <span class="badge text-bg-light border">@schedule.RoundingMode</span>
                        <span class="rc-help">
                            @schedule.EffectiveFrom.ToString("yyyy-MM-dd") →
                            @(schedule.EffectiveTo?.ToString("yyyy-MM-dd") ?? "open")
                            @if (schedule.EffectiveFrom <= today
                                 && (schedule.EffectiveTo is null || schedule.EffectiveTo >= today)
                                 && schedule.IsActive)
                            {
                                <span class="badge text-bg-primary ms-1">in force today</span>
                            }
                        </span>
                        @if (!schedule.IsActive)
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                        <div class="ms-auto">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Index" asp-route-id="@selected.CounterpartyId"
                               asp-route-feeScheduleId="@schedule.FeeScheduleId">Tiers</a>
                        </div>
                    </div>

                    @if (schedule.Gaps.Count > 0)
                    {
                        @* The engine throws on a transaction no tier covers —
                           deliberately, because the alternative is charging
                           nothing and nobody noticing. Saying it here means
                           the operator does not learn it at 3am. *@
                        <div class="alert alert-danger m-2 mb-0 small" role="alert">
                            <strong>The bands are not continuous.</strong>
                            <ul class="mb-0 mt-1">
                                @foreach (var gap in schedule.Gaps)
                                {
                                    <li>@gap</li>
                                }
                            </ul>
                            A transaction landing in a gap fails the run rather than being charged
                            zero.
                        </div>
                    }

                    <div class="rc-table-scroll">
                        <table class="table rc-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="text-end">From (minor)</th>
                                    <th class="text-end">To (minor)</th>
                                    <th>Calculation</th>
                                    <th class="text-end">Fixed</th>
                                    <th class="text-end">Percent</th>
                                    <th class="text-end">Min fee</th>
                                    <th class="text-end">Max fee</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (schedule.Tiers.Count == 0)
                                {
                                    <tr><td colspan="8" class="rc-empty">No tiers — this schedule charges nothing.</td></tr>
                                }
                                @foreach (var tier in schedule.Tiers)
                                {
                                    <tr>
                                        <td class="rc-num">
                                            @Fmt.Count(tier.AmountFromMinor)
                                            <span class="rc-help">@Fmt.Money(tier.AmountFromMinor, schedule.CurrencyCode)</span>
                                        </td>
                                        <td class="rc-num">
                                            @if (tier.AmountToMinor is { } to)
                                            {
                                                @Fmt.Count(to)
                                                <span class="rc-help">@Fmt.Money(to, schedule.CurrencyCode)</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-light border">open-ended</span>
                                            }
                                        </td>
                                        <td>@tier.CalculationType</td>
                                        <td class="rc-num">@Fmt.Count(tier.FixedAmountMinor)</td>
                                        <td class="rc-num">@tier.Percentage.ToString("0.######")</td>
                                        <td class="rc-num">@(tier.MinFeeMinor is { } min ? Fmt.Count(min) : "—")</td>
                                        <td class="rc-num">@(tier.MaxFeeMinor is { } max ? Fmt.Count(max) : "—")</td>
                                        <td class="text-end">
                                            @if (canConfigure)
                                            {
                                                <div class="d-flex gap-1 justify-content-end">
                                                    <button class="btn btn-sm btn-outline-secondary rc-tier-edit"
                                                            type="button"
                                                            data-schedule="@schedule.FeeScheduleId"
                                                            data-id="@tier.FeeTierId"
                                                            data-from="@tier.AmountFromMinor"
                                                            data-to="@tier.AmountToMinor"
                                                            data-calc="@tier.CalculationType"
                                                            data-fixed="@tier.FixedAmountMinor"
                                                            data-pct="@tier.Percentage.ToString("0.######")"
                                                            data-min="@tier.MinFeeMinor"
                                                            data-max="@tier.MaxFeeMinor">Edit</button>
                                                    @if (!tier.IsUsed)
                                                    {
                                                        <form asp-action="DeleteTier" method="post" class="m-0">
                                                            <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                                                            <input type="hidden" name="feeScheduleId" value="@schedule.FeeScheduleId">
                                                            <input type="hidden" name="feeTierId" value="@tier.FeeTierId">
                                                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                                                    data-rc-confirm="Remove this tier?">Remove</button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="rc-help align-self-center"
                                                              title="Stored fees name the tier that produced them">
                                                            charged
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (canConfigure && (editing == schedule.FeeScheduleId || schedule.Tiers.Count == 0))
                    {
                        <form asp-action="SaveTier" method="post" class="row g-2 p-3 border-top rc-tier-form"
                              data-schedule="@schedule.FeeScheduleId">
                            <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                            <input type="hidden" name="feeScheduleId" value="@schedule.FeeScheduleId">
                            <input type="hidden" name="feeTierId" class="rc-tier-id">
                            <div class="col-md-2">
                                <label class="form-label">From (minor)</label>
                                <input class="form-control form-control-sm rc-tier-from" type="number"
                                       name="amountFromMinor" value="0" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">To (minor)</label>
                                <input class="form-control form-control-sm rc-tier-to" type="number"
                                       name="amountToMinor" placeholder="empty = open-ended">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Calculation</label>
                                <select class="form-select form-select-sm rc-tier-calc" name="calculationType">
                                    <option value="Fixed">Fixed</option>
                                    <option value="Percentage">Percentage</option>
                                    <option value="FixedPlusPercentage">FixedPlusPercentage</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Fixed (minor)</label>
                                <input class="form-control form-control-sm rc-tier-fixed" type="number"
                                       name="fixedAmountMinor" value="0" required>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Percent</label>
                                <input class="form-control form-control-sm rc-tier-pct" type="number"
                                       step="0.000001" name="percentage" value="0" required>
                                <div class="form-text">0.5 means 0.5%.</div>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Min</label>
                                <input class="form-control form-control-sm rc-tier-min" type="number"
                                       name="minFeeMinor">
                            </div>
                            <div class="col-md-1">
                                <label class="form-label">Max</label>
                                <input class="form-control form-control-sm rc-tier-max" type="number"
                                       name="maxFeeMinor">
                            </div>
                            <div class="col-12">
                                <button class="btn btn-sm btn-primary" type="submit">Save tier</button>
                                <span class="rc-help ms-2">
                                    Caps are applied after rounding, and the fee is rounded once per
                                    transaction and then summed — never summed and then rounded.
                                </span>
                            </div>
                        </form>
                    }
                </div>
            }
        </div>
    </div>

    @if (canConfigure)
    {
        <div class="rc-card mb-3">
            <div class="rc-card-head">
                <h2>Add or edit a schedule</h2>
            </div>
            <div class="p-3">
                <form asp-action="SaveSchedule" method="post" class="row g-3">
                    <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                    <div class="col-md-3">
                        <label class="form-label" for="feeScheduleId">Editing</label>
                        <select class="form-select" id="feeScheduleId" name="feeScheduleId" data-rc-schedules>
                            <option value="">(new schedule)</option>
                            @foreach (var schedule in schedules)
                            {
                                <option value="@schedule.FeeScheduleId"
                                        data-code="@schedule.Code"
                                        data-name="@schedule.Name"
                                        data-direction="@schedule.Direction"
                                        data-txntype="@schedule.TransactionType"
                                        data-party="@schedule.FeeParty"
                                        data-currency="@schedule.CurrencyCode"
                                        data-rounding="@schedule.RoundingMode"
                                        data-from="@schedule.EffectiveFrom.ToString("yyyy-MM-dd")"
                                        data-to="@(schedule.EffectiveTo?.ToString("yyyy-MM-dd"))"
                                        data-active="@schedule.IsActive.ToString().ToLowerInvariant()">
                                    @schedule.Code (@schedule.EffectiveFrom.ToString("yyyy-MM-dd"))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="scheduleCode">Code</label>
                        <input class="form-control" id="scheduleCode" name="code" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="scheduleName">Name</label>
                        <input class="form-control" id="scheduleName" name="name" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="direction">Direction</label>
                        <select class="form-select" id="direction" name="direction">
                            <option value="Inward">Inward</option>
                            <option value="Outward">Outward</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="feeParty">Party</label>
                        <select class="form-select" id="feeParty" name="feeParty">
                            <option value="Revenue">Revenue — paid to us</option>
                            <option value="Cost">Cost — paid by us</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label" for="transactionType">Transaction type</label>
                        <input class="form-control" id="transactionType" name="transactionType"
                               placeholder="all types">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="currencyCode">Currency</label>
                        <select class="form-select" id="currencyCode" name="currencyCode">
                            @foreach (var currency in currencies)
                            {
                                <option value="@currency.Code" selected="@(currency.Code == "JOD")">
                                    @currency.Code (@currency.MinorUnits minor units)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="roundingMode">Rounding</label>
                        <select class="form-select" id="roundingMode" name="roundingMode">
                            <option value="HalfUp">HalfUp</option>
                            <option value="HalfEven">HalfEven</option>
                            <option value="Truncate">Truncate</option>
                        </select>
                        @* STILL OPEN (review item C8): HalfUp is the schema
                           default and a guess. *@
                        <div class="form-text text-danger">
                            Still open: obtain the counterparty's stated rounding rule. HalfUp is a
                            default, not a decision, and netting will not tie out if it is wrong.
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="effectiveFrom">Effective from</label>
                        <input class="form-control" type="date" id="effectiveFrom" name="effectiveFrom"
                               value="@today.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="effectiveTo">Effective to</label>
                        <input class="form-control" type="date" id="effectiveTo" name="effectiveTo">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="scheduleActive"
                                   name="isActive" value="true" checked>
                            <input type="hidden" name="isActive" value="false">
                            <label class="form-check-label" for="scheduleActive">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Save schedule</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="rc-card mb-3">
            <div class="rc-card-head">
                <h2>Applicability</h2>
                <span class="rc-help">some reconciliations carry fees and some do not</span>
            </div>
            <div class="rc-table-scroll">
                <table class="table rc-table align-middle">
                    <thead>
                        <tr><th>Dataset</th><th>Transaction type</th><th>Fees apply</th><th>Schedule</th></tr>
                    </thead>
                    <tbody>
                        @if (applicability.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="rc-empty">
                                    No rules. With none at all every transaction of a dataset is
                                    charged by any schedule matching its direction and type.
                                </td>
                            </tr>
                        }
                        @foreach (var rule in applicability)
                        {
                            <tr>
                                <td class="rc-mono">@rule.DatasetCode</td>
                                <td class="rc-mono">@(rule.TransactionType ?? "(all types)")</td>
                                <td>
                                    @if (rule.IsFeeApplicable)
                                    {
                                        <span class="badge text-bg-success">yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">no</span>
                                    }
                                </td>
                                <td class="rc-mono">@(rule.ScheduleCode ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3 border-top">
                <form asp-action="SaveApplicability" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                    <div class="col-md-3">
                        <label class="form-label" for="datasetId">Dataset</label>
                        <select class="form-select form-select-sm" id="datasetId" name="datasetId" required>
                            @foreach (var dataset in datasets)
                            {
                                <option value="@dataset.DatasetId">@dataset.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="appTxnType">Transaction type</label>
                        <input class="form-control form-control-sm" id="appTxnType" name="transactionType"
                               placeholder="empty = all types">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="isFeeApplicable">Fees apply</label>
                        <select class="form-select form-select-sm" id="isFeeApplicable" name="isFeeApplicable">
                            <option value="true">yes</option>
                            <option value="false">no</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="appSchedule">Schedule</label>
                        <select class="form-select form-select-sm" id="appSchedule" name="feeScheduleId">
                            <option value="">(none)</option>
                            @foreach (var schedule in schedules)
                            {
                                <option value="@schedule.FeeScheduleId">@schedule.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
                    </div>
                    <div class="col-12 rc-help">
                        A specific transaction type wins over the dataset-wide default, and one
                        ruling per pair is enforced by the database. A dataset marked not
                        fee-bearing is <em>skipped</em>, not charged zero: zero is a fee, absence is
                        not.
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="rc-card">
        <div class="rc-card-head">
            <h2>Interchange netting</h2>
            <span class="rc-help">revenue − cost, against what the counterparty reported</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table align-middle">
                <thead>
                    <tr>
                        <th>Run</th><th>Definition</th><th>Business date</th><th>Ccy</th>
                        <th class="text-end">Inward</th><th class="text-end">Outward</th>
                        <th class="text-end">Revenue</th><th class="text-end">Cost</th>
                        <th class="text-end">Netting</th><th class="text-end">Reported</th>
                        <th class="text-end">Difference</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (summaries.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="rc-empty">
                                No fees have been calculated yet. Fee calculation is separate from
                                the run so a tariff correction can be re-applied without
                                re-reconciling the day.
                            </td>
                        </tr>
                    }
                    @foreach (var summary in summaries)
                    {
                        var scale = Scale(summary.CurrencyCode);
                        <tr>
                            <td class="rc-mono">
                                <a asp-controller="Runs" asp-action="Detail" asp-route-id="@summary.RunId">
                                    @summary.RunId
                                </a>
                            </td>
                            <td class="rc-mono">@summary.DefinitionCode</td>
                            <td class="rc-mono">@summary.BusinessDate.ToString("yyyy-MM-dd")</td>
                            <td class="rc-mono">@summary.CurrencyCode</td>
                            <td class="rc-num">
                                @Fmt.Count(summary.InwardCount)
                                <span class="rc-help">@MinorUnits.Format(summary.InwardAmountMinor, scale)</span>
                            </td>
                            <td class="rc-num">
                                @Fmt.Count(summary.OutwardCount)
                                <span class="rc-help">@MinorUnits.Format(summary.OutwardAmountMinor, scale)</span>
                            </td>
                            <td class="rc-num">@MinorUnits.Format(summary.RevenueMinor, scale)</td>
                            <td class="rc-num">@MinorUnits.Format(summary.CostMinor, scale)</td>
                            <td class="rc-num">@MinorUnits.Format(summary.NettingMinor, scale)</td>
                            <td class="rc-num">
                                @if (summary.ReportedNettingMinor is { } reported)
                                {
                                    @MinorUnits.Format(reported, scale)
                                }
                                else
                                {
                                    <span class="rc-help">not recorded</span>
                                }
                            </td>
                            <td class="rc-num @(summary.ReportedNettingMinor is not null && summary.DifferenceMinor != 0 ? "rc-num-neg" : null)">
                                @if (summary.ReportedNettingMinor is null)
                                {
                                    <span class="rc-help">—</span>
                                }
                                else
                                {
                                    @MinorUnits.Format(summary.DifferenceMinor, scale)
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="SaveReported" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                                    <input type="hidden" name="interchangeSummaryId" value="@summary.InterchangeSummaryId">
                                    <input class="form-control form-control-sm" type="number" style="width:130px"
                                           name="reportedNettingMinor" value="@summary.ReportedNettingMinor"
                                           placeholder="their figure" aria-label="Reported netting in minor units">
                                    <button class="btn btn-sm btn-outline-primary" type="submit">Set</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3 border-top">
            <form asp-action="Calculate" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="counterpartyId" value="@selected.CounterpartyId">
                <div class="col-md-3">
                    <label class="form-label" for="runId">Calculate fees for run</label>
                    <input class="form-control form-control-sm" type="number" id="runId" name="runId" required
                           placeholder="run id">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-sm btn-primary" type="submit">Calculate</button>
                </div>
                <div class="col-12 rc-help">
                    Idempotent: it replaces that run's fees rather than doubling them. The netting
                    is then compared against the counterparty's own reported figure — as an
                    ordinary reconciliation, which is why there is no special comparison code.
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/fees.js"></script>
}
