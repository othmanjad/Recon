@using Recon.Domain.Configuration
@using Recon.Web.Controllers
@using Recon.Web.Services
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    var definitions = (List<DefinitionRow>)ViewData["Definitions"]!;
    var definition = ViewData["Selected"] as ReconciliationDefinition;
    var problems = (IReadOnlyList<string>)ViewData["Problems"]!;
    var replayable = ViewData["Replayable"] as List<SandboxSource> ?? [];
    var canConfigure = ViewData["CanConfigure"] is true;
    var exclusions = (List<ExclusionRow>)ViewData["Exclusions"]!;
    var classifications = (List<ClassificationRow>)ViewData["Classifications"]!;
    var controlTotals = (List<ControlTotalRow2>)ViewData["ControlTotals"]!;

    object Fields(Dataset dataset) => dataset.Fields
        .OrderBy(f => f.DisplayOrder)
        .Select(f => new
        {
            code = f.FieldCode,
            label = f.DisplayLabel,
            type = f.DataType.ToString(),
            role = f.Role?.ToString(),
            matchable = f.IsMatchable,
            indexed = f.IsIndexed,
            normalize = f.NormalizeForMatch,
        });
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">Rule builder</h1>
    <form method="get" asp-action="Index" class="d-flex gap-2 rc-picker">
        <select class="form-select form-select-sm" name="id" style="width:auto" aria-label="Definition">
            @foreach (var row in definitions)
            {
                <option value="@row.DefinitionId" selected="@(definition?.DefinitionId == row.DefinitionId)">
                    @row.Code — @row.Name
                </option>
            }
        </select>
        <button class="btn btn-sm btn-primary" type="submit">Open</button>
    </form>
</div>

@*
    The design's single most important safety property (§6), stated where
    the rules are built: both sides of every condition come from the field
    registries, never from typed text.
*@
<div class="alert alert-light border d-flex gap-2 align-items-start">
    <i class="bi bi-shield-check fs-5 text-primary" aria-hidden="true"></i>
    <div class="small">
        <strong>Why this builder is safe.</strong> Every field in every condition is chosen from a
        dataset's field registry and submitted as a code that the server resolves against that
        same registry. A code that is not in it, or is in it but not marked matchable, is refused
        before anything is written — and one class, only one, turns a resolved condition into SQL,
        with every value parameterized.
    </div>
</div>

@if (definition is null)
{
    <div class="rc-card"><div class="rc-empty">No definition is visible to you.</div></div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="rc-card h-100">
                <div class="rc-card-head">
                    <h2>@definition.Code — @definition.Name</h2>
                    @if (definition.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                </div>
                <div class="p-3 small">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="rc-tile-label">Left dataset</div>
                            <div class="rc-mono">@definition.Left.Code</div>
                            <div class="rc-help">
                                @definition.Left.Fields.Count fields,
                                @definition.Left.Matchable.Count() matchable
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="rc-tile-label">Right dataset</div>
                            <div class="rc-mono">@definition.Right.Code</div>
                            <div class="rc-help">
                                @definition.Right.Fields.Count fields,
                                @definition.Right.Matchable.Count() matchable
                            </div>
                        </div>
                    </div>
                    <hr>
                    <div>
                        Matching window: <strong>−@definition.MatchingWindowDaysBefore</strong> /
                        <strong>+@definition.MatchingWindowDaysAfter</strong> days around the
                        business date. Late arrivals mean the range is never simply
                        "= business date".
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="rc-card h-100">
                <div class="rc-card-head"><h2>Activation</h2></div>
                <div class="p-3">
                    @if (problems.Count == 0)
                    {
                        <div class="d-flex gap-2 align-items-start small">
                            <i class="bi bi-check-circle text-success fs-5" aria-hidden="true"></i>
                            <div>
                                This definition can run: both registries carry the universal roles,
                                there is an active pass, and the first pass can seek an index.
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="mb-0 small text-danger">
                            @foreach (var problem in problems)
                            {
                                <li class="mb-1">@problem</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <h2 class="h6 text-uppercase rc-help mb-2">Passes</h2>

    @*
        Passes run in order and write only to ops.MatchResult; staging is
        never updated mid-run. "Still unmatched" for pass N is an anti-join
        against passes 1..N-1 — which is why the order on screen is the order
        in the run.
    *@
    <p class="rc-help mb-3">
        Passes run in sequence. Each one sees only what the passes before it left unmatched, so
        pass 1 should be the strictest, cheapest match — and a first pass whose comparison cannot
        seek an index scans both sides in full, which at 2M rows a day is the difference between a
        minute and an hour.
    </p>

    @foreach (var pass in definition.Rules.OrderBy(r => r.Sequence))
    {
        <div class="rc-pass">
            <form asp-action="SavePass" method="post">
                <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                <input type="hidden" name="matchRuleId" value="@pass.MatchRuleId">

                <div class="rc-pass-head">
                    <span class="rc-seq">@pass.Sequence</span>
                    <input class="form-control form-control-sm rc-mono" name="ruleCode"
                           value="@pass.RuleCode" style="width:190px" required aria-label="Rule code">
                    <input class="form-control form-control-sm" name="name" value="@pass.Name"
                           style="width:260px" required aria-label="Pass name">
                    <input class="form-control form-control-sm" type="number" name="sequence"
                           value="@pass.Sequence" style="width:80px" required aria-label="Sequence">

                    <select class="form-select form-select-sm" name="matchMode" style="width:auto"
                            aria-label="Match mode">
                        @foreach (var mode in Enum.GetNames<MatchMode>())
                        {
                            <option value="@mode" selected="@(pass.Mode.ToString() == mode)">
                                @RuleWords.Mode(mode)
                            </option>
                        }
                    </select>

                    <select class="form-select form-select-sm" name="onMultipleMatch" style="width:auto"
                            aria-label="On multiple match">
                        @foreach (var choice in Enum.GetNames<OnMultipleMatch>())
                        {
                            <option value="@choice" selected="@(pass.OnMultipleMatch.ToString() == choice)">
                                @RuleWords.OnMultiple(choice)
                            </option>
                        }
                    </select>

                    @if (!pass.IsFullySeekable)
                    {
                        <span class="badge text-bg-warning" title="A comparison in this pass cannot use an index">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> scans
                        </span>
                    }

                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-sm btn-primary" type="submit">Save pass</button>
                    </div>
                </div>

                <div class="rc-conditions" data-pass="@pass.MatchRuleId">
                    @foreach (var condition in pass.Conditions.OrderBy(c => c.Sequence))
                    {
                        var scanning = condition.Comparison is ComparisonType.Contains or ComparisonType.EndsWith;
                        <div class="rc-cond-row @(scanning ? "rc-warn-nonsargable" : null)">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm rc-left" name="leftFieldCodes"
                                            aria-label="Left field">
                                        @* The data- attributes are what the
                                           builder's advice reads: without them
                                           on the server-rendered options, a
                                           saved condition comparing two
                                           normalized companions was told it
                                           had none. *@
                                        @foreach (var field in definition.Left.Matchable.OrderBy(f => f.DisplayOrder))
                                        {
                                            <option value="@field.FieldCode"
                                                    data-type="@field.DataType"
                                                    data-normalize="@field.NormalizeForMatch.ToString().ToLowerInvariant()"
                                                    data-indexed="@field.IsIndexed.ToString().ToLowerInvariant()"
                                                    selected="@(field.FieldCode == condition.LeftFieldCode)">
                                                @field.DisplayLabel (@field.FieldCode)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    @* In words, and wide enough to read them:
                                       a saved condition used to show the C#
                                       name of its comparison, which is the one
                                       thing the person editing it cannot look
                                       up. *@
                                    <select class="form-select form-select-sm rc-cmp" name="comparisons"
                                            aria-label="Comparison">
                                        @foreach (var comparison in Enum.GetNames<ComparisonType>())
                                        {
                                            <option value="@comparison"
                                                    selected="@(condition.Comparison.ToString() == comparison)">
                                                @RuleWords.Comparison(comparison)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm rc-right" name="rightFieldCodes"
                                            aria-label="Right field">
                                        @foreach (var field in definition.Right.Matchable.OrderBy(f => f.DisplayOrder))
                                        {
                                            <option value="@field.FieldCode"
                                                    data-type="@field.DataType"
                                                    data-normalize="@field.NormalizeForMatch.ToString().ToLowerInvariant()"
                                                    data-indexed="@field.IsIndexed.ToString().ToLowerInvariant()"
                                                    selected="@(field.FieldCode == condition.RightFieldCode)">
                                                @field.DisplayLabel (@field.FieldCode)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-1">
                                    <input class="form-control form-control-sm rc-tol" type="number"
                                           name="tolerances" value="@(condition.ToleranceValue?.ToString())"
                                           placeholder="tol" aria-label="Tolerance">
                                </div>
                                <div class="col-md-2">
                                    <select class="form-select form-select-sm rc-unit" name="toleranceUnits"
                                            aria-label="Tolerance unit">
                                        <option value="">— الوحدة —</option>
                                        @foreach (var unit in Enum.GetNames<ToleranceUnit>())
                                        {
                                            <option value="@unit"
                                                    selected="@(condition.ToleranceUnit?.ToString() == unit)">
                                                @RuleWords.Unit(unit)
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap" dir="rtl">
                                <span class="rc-help">تُقارن القيم:</span>
                                @*
                                    A select rather than a checkbox: every
                                    condition must contribute exactly one
                                    value to each array, or the arrays stop
                                    lining up and a tolerance lands on the
                                    wrong condition.
                                *@
                                <select class="form-select form-select-sm rc-norm" name="useNormalized"
                                        style="width:auto" aria-label="Compare normalized companions">
                                    <option value="false" selected="@(!condition.UseNormalized)">
                                        كما وردت · raw
                                    </option>
                                    <option value="true" selected="@condition.UseNormalized">
                                        بعد التوحيد · normalized
                                    </option>
                                </select>
                                <span class="rc-help rc-cond-note"></span>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 p-2 border-top align-items-center">
                    <button class="btn btn-sm btn-outline-primary rc-add-cond" type="button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add condition
                    </button>
                    <span class="rc-help">
                        Conditions within a pass are ANDed. Saving replaces this pass's conditions
                        with exactly what is on screen.
                    </span>
                </div>
            </form>

            <form asp-action="DeletePass" method="post" class="p-2 border-top">
                <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                <input type="hidden" name="matchRuleId" value="@pass.MatchRuleId">
                <button class="btn btn-sm btn-outline-danger" type="submit"
                        data-rc-confirm="Remove pass @pass.Sequence (@pass.RuleCode)? Its match results from past runs are kept.">
                    Remove pass
                </button>
            </form>
        </div>
    }

    <div class="rc-pass" id="rc-new-pass">
        <form asp-action="SavePass" method="post">
            <input type="hidden" name="definitionId" value="@definition.DefinitionId">

            <div class="rc-pass-head">
                <span class="rc-seq">+</span>
                @* Both optional: the server derives a code and a name from
                   the first condition when they are left blank, which is what
                   anyone would have typed. One real user typed "True". *@
                <input class="form-control form-control-sm rc-mono" name="ruleCode"
                       placeholder="الكود (تلقائي)" style="width:190px" aria-label="Rule code">
                <input class="form-control form-control-sm" name="name"
                       placeholder="الوصف (تلقائي)" style="width:260px" aria-label="Pass name">
                <input class="form-control form-control-sm" type="number" name="sequence"
                       value="@(definition.Rules.Count == 0 ? 1 : definition.Rules.Max(r => r.Sequence) + 1)"
                       style="width:80px" required aria-label="Sequence">
                <select class="form-select form-select-sm" name="matchMode" style="width:auto"
                        aria-label="Match mode">
                    @foreach (var mode in Enum.GetNames<MatchMode>())
                    {
                        <option value="@mode">@RuleWords.Mode(mode)</option>
                    }
                </select>
                <select class="form-select form-select-sm" name="onMultipleMatch" style="width:auto"
                        aria-label="On multiple match">
                    @foreach (var choice in Enum.GetNames<OnMultipleMatch>())
                    {
                        <option value="@choice">@RuleWords.OnMultiple(choice)</option>
                    }
                </select>
                <div class="ms-auto">
                    <button class="btn btn-sm btn-primary" type="submit">Add pass</button>
                </div>
            </div>

            <div class="rc-conditions" data-pass="new"></div>

            <div class="d-flex gap-2 p-2 border-top align-items-center">
                <button class="btn btn-sm btn-outline-primary rc-add-cond" type="button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Add condition
                </button>
                <span class="rc-help">
                    A pass with no condition is refused: it would match every row against every row.
                </span>
            </div>
        </form>
    </div>

    @* ---------------------------------------------------------------
        The three rule sets the engine reads beside the passes. They were
        SQL-only, which meant a definition could be built in the portal and
        still needed a developer to decide what an unmatched row is called
        and whether the money adds up.
       --------------------------------------------------------------- *@
    <div class="rc-card mt-4">
        <div class="rc-card-head">
            <h2>Exclusions</h2>
            <span class="rc-help">rows that must never enter matching</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table align-middle mb-0">
                <thead>
                    <tr><th>Dataset</th><th>Name</th><th>Condition</th><th>Reason</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (exclusions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="rc-empty">
                                None. Every staged row enters matching, which is correct unless the
                                source sends rows that were never meant to match — a rejected
                                transaction, for instance.
                            </td>
                        </tr>
                    }
                    @foreach (var rule in exclusions)
                    {
                        <tr>
                            <td class="rc-mono">@rule.DatasetCode</td>
                            <td>@rule.Name</td>
                            <td class="rc-mono rc-help" style="max-width:320px">@rule.ConditionJson</td>
                            <td class="rc-mono">@rule.ReasonCode</td>
                            <td>
                                @if (rule.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (canConfigure)
                                {
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-secondary rc-exclusion-edit"
                                                type="button"
                                                data-id="@rule.ExclusionRuleId"
                                                data-dataset="@rule.DatasetId"
                                                data-name="@rule.Name"
                                                data-json="@rule.ConditionJson"
                                                data-reason="@rule.ReasonCode"
                                                data-active="@rule.IsActive.ToString().ToLowerInvariant()">
                                            Edit
                                        </button>
                                        <form asp-action="DeleteExclusion" method="post" class="m-0">
                                            <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                                            <input type="hidden" name="exclusionRuleId" value="@rule.ExclusionRuleId">
                                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                                    data-rc-confirm="Remove the exclusion '@rule.Name'?">
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (canConfigure)
        {
            <div class="p-3 border-top">
                <form asp-action="SaveExclusion" method="post" class="row g-2 align-items-end"
                      id="rc-exclusion-form">
                    <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                    <input type="hidden" name="exclusionRuleId" id="exclusionRuleId">
                    <div class="col-md-2">
                        <label class="form-label" for="exDataset">Dataset</label>
                        <select class="form-select form-select-sm" id="exDataset" name="datasetId">
                            <option value="@definition.Left.DatasetId">@definition.Left.Code</option>
                            <option value="@definition.Right.DatasetId">@definition.Right.Code</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="exName">Name</label>
                        <input class="form-control form-control-sm" id="exName" name="name" required
                               placeholder="Rejected by the scheme">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="exReason">Reason code</label>
                        <input class="form-control form-control-sm rc-mono" id="exReason"
                               name="reasonCode" required placeholder="REJECTED">
                    </div>
                    <div class="col-12">
                        <label class="form-label">الشرط · Condition</label>
                        <div id="exBuilder"></div>
                        <input type="hidden" id="exJson" name="conditionJson">

                        @* The JSON is still reachable: a rule that needs a
                           nested group is rarer than one that does not, and
                           hiding the schema entirely would make it
                           unreachable rather than simple. *@
                        <details class="mt-2">
                            <summary class="rc-help">تعديل الشرط كـ JSON · advanced</summary>
                            <input class="form-control form-control-sm rc-mono mt-2" id="exJsonRaw"
                                   aria-label="Condition JSON"
                                   placeholder='{"op":"and","items":[{"field":"STATUS","cmp":"eq","value":"RJCT"}]}'>
                            <div class="form-text">
                                يُطبَّق عند الحفظ ويستبدل ما بُني أعلاه.
                            </div>
                        </details>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="exActive"
                                   name="isActive" value="true" checked>
                            <input type="hidden" name="isActive" value="false">
                            <label class="form-check-label" for="exActive">On</label>
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-sm btn-primary" type="submit">Save exclusion</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                id="rc-exclusion-reset">New</button>
                        <span class="rc-help align-self-center">
                            Validated against that dataset's registry on save. An excluded row
                            raises no exception: a rejected transaction is not a break, and
                            treating it as one buries the real ones.
                        </span>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="rc-card mt-3">
        <div class="rc-card-head">
            <h2>Classifications</h2>
            <span class="rc-help">what an unmatched row is called — first matching rule wins</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-end">#</th><th>Code</th><th>Name</th><th>Side</th>
                        <th>Condition</th><th>Severity</th><th>Action</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (classifications.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="rc-empty">
                                None. Unmatched rows stay unmatched and raise no exception — which
                                is correct: an exception code the configuration never named would
                                be invented.
                            </td>
                        </tr>
                    }
                    @foreach (var rule in classifications)
                    {
                        <tr>
                            <td class="rc-num">@rule.Sequence</td>
                            <td class="rc-mono">@rule.ExceptionCode</td>
                            <td>@rule.DisplayName</td>
                            <td class="rc-help">@rule.AppliesToSide</td>
                            <td class="rc-mono rc-help" style="max-width:280px">@rule.ConditionJson</td>
                            <td>
                                @{
                                    var tone = rule.Severity switch
                                    {
                                        "Critical" => "danger",
                                        "High" => "warning",
                                        "Normal" => "info",
                                        _ => "light",
                                    };
                                }
                                <span class="badge text-bg-@tone @(tone == "light" ? "border" : null)">
                                    @rule.Severity
                                </span>
                            </td>
                            <td class="rc-help">@rule.ActionType</td>
                            <td>
                                @if (rule.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (canConfigure)
                                {
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-secondary rc-classification-edit"
                                                type="button"
                                                data-id="@rule.ClassificationRuleId"
                                                data-code="@rule.ExceptionCode"
                                                data-label="@rule.DisplayName"
                                                data-side="@rule.AppliesToSide"
                                                data-json="@rule.ConditionJson"
                                                data-action="@rule.ActionType"
                                                data-severity="@rule.Severity"
                                                data-seq="@rule.Sequence"
                                                data-active="@rule.IsActive.ToString().ToLowerInvariant()">
                                            Edit
                                        </button>
                                        <form asp-action="DeleteClassification" method="post" class="m-0">
                                            <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                                            <input type="hidden" name="classificationRuleId" value="@rule.ClassificationRuleId">
                                            <button class="btn btn-sm btn-outline-danger" type="submit"
                                                    data-rc-confirm="Remove @rule.ExceptionCode? Exceptions already raised under it are kept.">
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (canConfigure)
        {
            <div class="p-3 border-top">
                <form asp-action="SaveClassification" method="post" class="row g-2 align-items-end"
                      id="rc-classification-form">
                    <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                    <input type="hidden" name="classificationRuleId" id="classificationRuleId">
                    <div class="col-md-2">
                        <label class="form-label" for="clCode">Exception code</label>
                        <input class="form-control form-control-sm rc-mono" id="clCode"
                               name="exceptionCode" required placeholder="MISSING_IN_LEDGER">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="clName">Name</label>
                        <input class="form-control form-control-sm" id="clName" name="displayName"
                               required placeholder="In the statement, not in the ledger">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="clSide">Side</label>
                        <select class="form-select form-select-sm" id="clSide" name="appliesToSide">
                            @foreach (var side in new[] { "Left", "Right", "Both" })
                            {
                                <option value="@side">@RuleWords.Side(side)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label" for="clSeq">Seq</label>
                        <input class="form-control form-control-sm" type="number" id="clSeq"
                               name="sequence" min="1" required
                               value="@(classifications.Count == 0 ? 1 : classifications.Max(c => c.Sequence) + 1)">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="clSeverity">Severity</label>
                        <select class="form-select form-select-sm" id="clSeverity" name="severity">
                            <option value="Low">Low</option>
                            <option value="Normal" selected>Normal</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="clAction">Action</label>
                        <select class="form-select form-select-sm" id="clAction" name="actionType">
                            <option value="ReportOnly" selected>ReportOnly</option>
                            <option value="AutoClose">AutoClose</option>
                            <option value="AutoPost">AutoPost (not implemented)</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="clActive"
                                   name="isActive" value="true" checked>
                            <input type="hidden" name="isActive" value="false">
                            <label class="form-check-label" for="clActive">On</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">الشرط · Condition</label>
                        <div id="clBuilder"></div>
                        <input type="hidden" id="clJson" name="conditionJson">

                        <details class="mt-2">
                            <summary class="rc-help">تعديل الشرط كـ JSON · advanced</summary>
                            <input class="form-control form-control-sm rc-mono mt-2" id="clJsonRaw"
                                   aria-label="Condition JSON"
                                   placeholder='{"op":"and","items":[{"field":"DIRECTION","cmp":"eq","value":"Inward"}]}'>
                            <div class="form-text">
                                يُطبَّق عند الحفظ ويستبدل ما بُني أعلاه.
                            </div>
                        </details>
                        @*
                            A rule for both sides has to resolve against both
                            registries, and the two sides name nothing alike.
                        *@
                        <div class="form-text">
                            Validated on save against the side's registry — and against
                            <strong>both</strong> when the side is Both, because a condition on the
                            left's field names is not one the right can evaluate.
                        </div>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-sm btn-primary" type="submit">Save classification</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                id="rc-classification-reset">New</button>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="rc-card mt-3">
        <div class="rc-card-head">
            <h2>Control totals</h2>
            <span class="rc-help">a fully matched run that does not balance is a failed run</span>
        </div>
        <div class="rc-table-scroll">
            <table class="table rc-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Check</th><th>A</th><th>B</th><th>Scope</th>
                        <th class="text-end">Tolerance</th><th>On mismatch</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (controlTotals.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="rc-empty">
                                None. The run will report matched and unmatched counts and prove
                                nothing about the money — the balance proof is what makes those
                                counts trustworthy.
                            </td>
                        </tr>
                    }
                    @foreach (var check in controlTotals)
                    {
                        <tr>
                            <td>
                                <div class="rc-mono">@check.CheckCode</div>
                                <div class="rc-help">@check.DisplayName</div>
                            </td>
                            <td class="rc-mono rc-help" style="max-width:220px">
                                @check.SourceTypeA<br>@check.SourceAJson
                            </td>
                            <td class="rc-mono rc-help" style="max-width:220px">
                                @check.SourceTypeB<br>@check.SourceBJson
                            </td>
                            <td>
                                @check.Scope
                                @if (check.PeriodDays is { } days)
                                {
                                    <span class="rc-help">@days d</span>
                                }
                            </td>
                            <td class="rc-num">@Fmt.Count(check.ToleranceMinor)</td>
                            <td>
                                @if (check.FailRunOnMismatch)
                                {
                                    <span class="badge text-bg-danger">fails the run</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">reported</span>
                                }
                            </td>
                            <td>
                                @if (check.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (canConfigure)
                                {
                                    <div class="d-flex gap-1 justify-content-end">
                                        @if (!check.HasResults)
                                        {
                                            <form asp-action="DeleteControlTotal" method="post" class="m-0">
                                                <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                                                <input type="hidden" name="controlTotalId" value="@check.ControlTotalId">
                                                <button class="btn btn-sm btn-outline-danger" type="submit"
                                                        data-rc-confirm="Remove @check.CheckCode?">Remove</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="rc-help align-self-center"
                                                  title="A past run's balance proof references this check">
                                                has results
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (canConfigure)
        {
            <div class="p-3 border-top">
                <form asp-action="SaveControlTotal" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                    <div class="col-md-2">
                        <label class="form-label" for="ctCode">Check code</label>
                        <input class="form-control form-control-sm rc-mono" id="ctCode"
                               name="checkCode" required placeholder="MATCHED_TOTAL">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ctName">Name</label>
                        <input class="form-control form-control-sm" id="ctName" name="displayName"
                               required placeholder="Matched value agrees">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="ctScope">Scope</label>
                        <select class="form-select form-select-sm" id="ctScope" name="scope">
                            <option value="Run" selected>Run</option>
                            <option value="BusinessDate">BusinessDate</option>
                            <option value="Period">Period</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label" for="ctPeriod">Days</label>
                        <input class="form-control form-control-sm" type="number" id="ctPeriod"
                               name="periodDays" min="1" placeholder="—">
                        <div class="form-text">Period only.</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="ctTolerance">Tolerance (minor)</label>
                        <input class="form-control form-control-sm" type="number" id="ctTolerance"
                               name="toleranceMinor" value="0" min="0" required>
                        <div class="form-text">0 is exact.</div>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ctFails"
                                   name="failRunOnMismatch" value="true" checked>
                            <input type="hidden" name="failRunOnMismatch" value="false">
                            <label class="form-check-label" for="ctFails">Fails the run</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ctActive"
                                   name="isActive" value="true" checked>
                            <input type="hidden" name="isActive" value="false">
                            <label class="form-check-label" for="ctActive">On</label>
                        </div>
                    </div>

                    @* Two aggregates, built from parts rather than typed as
                       JSON — and compiled before they are stored. *@
                    <div class="col-md-6">
                        <div class="rc-tile-label mb-2">Side A</div>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label" for="functionA">Function</label>
                                <select class="form-select form-select-sm" id="functionA" name="functionA">
                                    <option value="SumAmount" selected>SumAmount</option>
                                    <option value="Count">Count</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label" for="sourceTypeA">Source</label>
                                <select class="form-select form-select-sm" id="sourceTypeA" name="sourceTypeA">
                                    @foreach (var source in Enum.GetNames<ControlTotalSource>())
                                    {
                                        <option value="@source" selected="@(source == "Staging")">@source</option>
                                    }
                                </select>
                            </div>
                            <div class="col-2">
                                <label class="form-label" for="sideA">Side</label>
                                <select class="form-select form-select-sm" id="sideA" name="sideA">
                                    <option value="Left" selected>Left</option>
                                    <option value="Right">Right</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <label class="form-label" for="matchStatusA">Status</label>
                                <select class="form-select form-select-sm" id="matchStatusA" name="matchStatusA">
                                    <option value="">any</option>
                                    @foreach (var status in Enum.GetNames<MatchStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="rc-tile-label mb-2">Side B</div>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label" for="functionB">Function</label>
                                <select class="form-select form-select-sm" id="functionB" name="functionB">
                                    <option value="SumAmount" selected>SumAmount</option>
                                    <option value="Count">Count</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label" for="sourceTypeB">Source</label>
                                <select class="form-select form-select-sm" id="sourceTypeB" name="sourceTypeB">
                                    @foreach (var source in Enum.GetNames<ControlTotalSource>())
                                    {
                                        <option value="@source" selected="@(source == "Staging")">@source</option>
                                    }
                                </select>
                            </div>
                            <div class="col-2">
                                <label class="form-label" for="sideB">Side</label>
                                <select class="form-select form-select-sm" id="sideB" name="sideB">
                                    <option value="Left">Left</option>
                                    <option value="Right" selected>Right</option>
                                </select>
                            </div>
                            <div class="col-2">
                                <label class="form-label" for="matchStatusB">Status</label>
                                <select class="form-select form-select-sm" id="matchStatusB" name="matchStatusB">
                                    <option value="">any</option>
                                    @foreach (var status in Enum.GetNames<MatchStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-sm btn-primary" type="submit">Save control total</button>
                        <span class="rc-help align-self-center">
                            The check is compiled before it is stored: one that cannot compile fails
                            the run it was added to protect. A period-scoped check must read
                            <code>RunAggregate</code> — it is the source that survives the staging
                            purge.
                        </span>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="row g-3 mt-2">
        <div class="col-xl-7">
            <div class="rc-card h-100">
                <div class="rc-card-head">
                    <h2>Row filter (condition tree)</h2>
                    <span class="rc-help">one schema for rules, classifications, exclusions, sources and reports</span>
                </div>
                <div class="p-3">
                    <p class="rc-help">
                        A filter narrows which rows a pass considers. It is a structured tree rather
                        than SQL text, and <code>field</code> is resolved against the registry — an
                        unknown code, or one the registry does not mark matchable, is rejected here
                        and never reaches the compiler.
                    </p>
                    @* Built from dropdowns like the rest of the screen. The box
                       below is still here because this card's whole subject is
                       the JSON the server is handed — but nobody has to type
                       it to use the card. *@
                    <div id="ftBuilder" class="mb-2"></div>
                    <label class="form-label" for="ct-json">
                        الشرط كـ JSON · what the server is handed
                    </label>
                    <textarea class="form-control rc-mono" id="ct-json" rows="7" spellcheck="false"></textarea>
                    <div class="form-text">
                        البنّاء أعلاه يكتب في هذا الصندوق. المثال المرفوض لا يمكن رسمه في
                        البنّاء — الحقل الذي يرفضه السجل غير موجود في قوائمه، وهذا هو
                        المقصود.
                    </div>
                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <button class="btn btn-sm btn-primary" id="btn-validate" type="button">Validate</button>
                        <button class="btn btn-sm btn-outline-secondary" id="btn-sample-ok" type="button">
                            Load a valid example
                        </button>
                        <button class="btn btn-sm btn-outline-danger" id="btn-sample-bad" type="button">
                            Load a rejected example
                        </button>
                    </div>
                    <div class="mt-3" id="ct-result">
                        <div class="rc-help">Not validated yet.</div>
                    </div>
                    <div class="rc-help mt-2">
                        Validation runs on the server against
                        <strong>@definition.Left.Code</strong>'s registry. The same check runs again
                        on save — this button exists to give an immediate answer, not to be the
                        boundary.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="rc-card h-100">
                <div class="rc-card-head">
                    <h2>Sandbox dry-run</h2>
                    <span class="rc-help">design §2.1 step 6 — not optional</span>
                </div>
                <div class="p-3">
                    <p class="rc-help">
                        Replays the current rule set over a past run's <em>already staged</em> rows
                        and reports the match rate per pass. Replaying real staged data says how the
                        rules behave on what actually arrived, rather than on rows somebody chose;
                        it reuses those rows rather than duplicating 2M of them, and the sandbox run
                        is excluded from current-run scope and purged by a nightly job.
                    </p>

                    @if (replayable.Count == 0)
                    {
                        <div class="rc-help">
                            No past run of this definition has staged rows to replay. Run it once
                            first — a dry-run over nothing would report zero matches and look like a
                            broken rule set.
                        </div>
                    }
                    else
                    {
                        <form asp-action="DryRun" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="definitionId" value="@definition.DefinitionId">
                            <div class="col-8">
                                <label class="form-label" for="sourceRunId">Replay the staged rows of</label>
                                <select class="form-select form-select-sm" id="sourceRunId" name="sourceRunId">
                                    @foreach (var source in replayable)
                                    {
                                        <option value="@source.RunId" disabled="@(!source.CanReplay)">
                                            run @source.RunId · @source.BusinessDate.ToString("yyyy-MM-dd")
                                            · @Fmt.Count(source.StagedRows) rows@(source.CanReplay ? "" : " — archived")
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-4">
                                <button class="btn btn-sm btn-primary w-100" type="submit">
                                    <i class="bi bi-play" aria-hidden="true"></i> Dry-run
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

}

@*
    A section must sit at the top level of the file, so the guard is inside
    it rather than around it.
*@
@section Scripts {
    @if (definition is not null)
    {
        <script>
            window.ReconRules = {
                definitionId: @definition.DefinitionId,
                left: { code: @Json.Serialize(definition.Left.Code), fields: @Json.Serialize(Fields(definition.Left)) },
                right: { code: @Json.Serialize(definition.Right.Code), fields: @Json.Serialize(Fields(definition.Right)) },
                comparisons: @Json.Serialize(Enum.GetNames<ComparisonType>()),
                units: @Json.Serialize(Enum.GetNames<ToleranceUnit>()),

                // The same words the server-rendered pickers use, handed to
                // the client so the condition rows it builds cannot drift
                // into a second vocabulary.
                words: {
                    comparisons: @Json.Serialize(Enum.GetNames<ComparisonType>()
                        .ToDictionary(c => c, RuleWords.Comparison)),
                    units: @Json.Serialize(Enum.GetNames<ToleranceUnit>()
                        .ToDictionary(u => u, RuleWords.Unit))
                },
                validateUrl: "@Url.Action("ValidateFilter")",
                token: "@Xsrf.GetAndStoreTokens(Context).RequestToken"
            };
        </script>
        <script src="~/js/condition-tree.js"></script>
        <script src="~/js/condition-builder.js"></script>
        <script src="~/js/rule-builder.js"></script>
    }
}
