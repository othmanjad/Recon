@model DashboardModel
@{
    var canOperate = ViewData["CanOperate"] is true;
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h4 mb-0">Runs</h1>
    <partial name="_RunFilters" model="Model" />
</div>

<div class="rc-card mb-3">
    <div class="rc-card-head">
        <h2>Trigger a run</h2>
        <span class="rc-help">the scheduler does this unattended; this is the manual path</span>
    </div>
    <div class="p-3">
        @if (!canOperate)
        {
            <div class="rc-help">
                Triggering a run needs <strong>Operate</strong> access to the counterparty. You hold
                read access, so the form is not shown rather than shown and refused.
            </div>
        }
        else
        {
            @*
                The application lock is what makes this safe alongside the
                scheduler (review item B2): a second attempt for the same
                definition and business date is refused and recorded as
                Rejected rather than staging the same data twice.
            *@
            <form asp-action="Trigger" method="post" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="definitionId">Definition</label>
                    <select class="form-select" id="definitionId" name="definitionId" required>
                        @foreach (var definition in Model.Definitions.Where(d => d.IsActive))
                        {
                            <option value="@definition.DefinitionId">@definition.Code — @definition.Name</option>
                        }
                    </select>
                    @if (!Model.Definitions.Any(d => d.IsActive))
                    {
                        <div class="form-text text-danger">
                            No definition is active. A definition is activated only once it has the
                            universal field roles and a first pass that can seek an index.
                        </div>
                    }
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="businessDate">Business date</label>
                    <input class="form-control" type="date" id="businessDate" name="businessDate"
                           value="@today.ToString("yyyy-MM-dd")" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="sessionRef">Session</label>
                    <input class="form-control" id="sessionRef" name="sessionRef" placeholder="optional">
                    <div class="form-text">e.g. a settlement session within the day.</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="runType">Type</label>
                    <select class="form-select" id="runType" name="runType">
                        <option value="Manual" selected>Manual</option>
                        <option value="Rerun">Rerun</option>
                        <option value="Rematch">Rematch</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Run</button>
                </div>
            </form>

            <div class="rc-help mt-3">
                A second attempt for the same definition and business date is <em>refused</em>, not
                queued: the run lock is held for the run's duration, and the refusal is recorded as
                a <code>Rejected</code> run so the attempt is visible rather than lost. This form
                asks each dataset's <em>acquisition</em> for the day's file — a folder is searched
                using the format's file-name pattern — and reconciles what is already staged for a
                dataset whose files are uploaded instead. To bring the files yourself, use the form
                below. A file that never arrived is recorded as <code>Rejected</code> with that
                reason, because a missing file and a run that matched nothing are not the same
                event.
            </div>
        }
    </div>
</div>

@if (canOperate)
{
    @*
        The whole pipeline from the browser: two files in, a reconciled run
        out. Before this, an operator holding two files from a partner needed
        somebody with a shell.
    *@
    <div class="rc-card mb-3">
        <div class="rc-card-head">
            <h2>Upload a session and reconcile it</h2>
            <span class="rc-help">acquire · parse · stage · match · classify · prove the totals</span>
        </div>
        <div class="p-3">
            <form asp-action="Upload" method="post" enctype="multipart/form-data"
                  class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="uploadDefinition">Definition</label>
                    <select class="form-select" id="uploadDefinition" name="definitionId" required
                            data-rc-definition-sides>
                        @foreach (var definition in Model.Definitions)
                        {
                            <option value="@definition.DefinitionId"
                                    data-left="@definition.LeftDatasetCode"
                                    data-right="@definition.RightDatasetCode">
                                @definition.Code — @definition.Name
                                @(definition.IsActive ? "" : " (inactive)")
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="uploadDate">Business date</label>
                    <input class="form-control" type="date" id="uploadDate" name="businessDate"
                           value="@today.ToString("yyyy-MM-dd")" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="uploadSession">Session</label>
                    <input class="form-control" id="uploadSession" name="sessionRef" placeholder="optional">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="uploadType">Type</label>
                    <select class="form-select" id="uploadType" name="runType">
                        <option value="Manual" selected>Manual</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="Rerun">Rerun</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit" id="rc-upload-submit">
                        Upload and run
                    </button>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="leftFile">
                        Left file — <span class="rc-mono" data-rc-left>—</span>
                    </label>
                    <input class="form-control" type="file" id="leftFile" name="leftFile">
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="rightFile">
                        Right file — <span class="rc-mono" data-rc-right>—</span>
                    </label>
                    <input class="form-control" type="file" id="rightFile" name="rightFile">
                </div>

                <div class="col-12 rc-help">
                    Each file is parsed with the format effective for that <em>business date</em>, so
                    a file from 2024 still reads correctly after the layout changed. A row that
                    fails to parse is rejected with its line, field and reason, and the rest of the
                    file still loads. The original is stored on disk with its SHA-256 — never as a
                    database blob, which at two million rows a day is how a database becomes
                    unmanageable.
                </div>
            </form>
        </div>
    </div>
}

<div class="rc-card">
    <div class="rc-card-head">
        <h2>All runs</h2>
        <span class="rc-help">@Model.Runs.Count shown, newest first</span>
    </div>
    <partial name="_RunTable" model="Model.Runs" />
</div>

@section Scripts {
    <script src="~/js/runs.js"></script>
}
